# One stack per deployment (docs/providers.md). Keep the block of the active AUTH_PROVIDER.

# --- Stack 1: Better Auth + FastAPI (spark-backend: docker compose up -d) ---
AUTH_PROVIDER=better-auth
API_BASE_URL=http://localhost:8000/v1
API_AUDIENCE=http://localhost:8000
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/spark
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=a-random-secret-key-at-least-32-chars-long
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- Stack 2: Supabase Auth + PostgREST/RLS ---
# Local: `pnpm --filter web exec supabase start` prints the URL and publishable key.
# Hosted: Project Settings > API Keys (publishable key only; never a secret/service_role key here).
# AUTH_PROVIDER=supabase
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

NEXT_PUBLIC_APP_URL=http://localhost:3000
