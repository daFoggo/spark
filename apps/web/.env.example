# Exactly one auth provider is active per deployment: "backend" | "supabase" | "better-auth"
AUTH_PROVIDER=better-auth

# --- better-auth provider ---
API_BASE_URL=http://localhost:8000/v1
API_AUDIENCE=http://localhost:8000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/spark
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=a-random-secret-key-at-least-32-chars-long
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- backend provider ---
# API_BASE_URL=http://localhost:8000
# SESSION_COOKIE_NAME=session
# SESSION_SECRET=

# --- supabase provider (public values, inlined at build time) ---
# NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<publishable key>

# --- public ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
