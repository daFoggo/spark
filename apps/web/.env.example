# One stack per deployment (docs/providers.md). Spark runs on Supabase.

# --- Supabase Auth + PostgREST/RLS (default) ---
# Local: `pnpm --filter @workspace/db exec supabase start` prints the URL and publishable key.
# Hosted: Project Settings > API Keys (publishable key only; never a secret/service_role key here).
AUTH_PROVIDER=supabase
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# --- Better Auth (identity foundation only; no data backend is hosted) ---
# AUTH_PROVIDER=better-auth
# DATABASE_URL=postgresql://postgres:postgres@localhost:2211/spark
# BETTER_AUTH_URL=http://localhost:3000
# BETTER_AUTH_SECRET=a-random-secret-key-at-least-32-chars-long
# API_AUDIENCE=http://localhost:2210
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

NEXT_PUBLIC_APP_URL=http://localhost:3000
